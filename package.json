{
  "name": "navris-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NAVRIS — Intelligent Navigation & Inertial System. Frontend for SIH 2026 (ISRO 26168).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "lint": "tsc -b --pretty",
    "preview": "vite preview",
    "verify": "esbuild src/sim/engine.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/navris-engine.mjs --log-level=warning && node scripts/verify-demo.mjs node_modules/.cache/navris-engine.mjs",
    "typecheck:watch": "tsc -b --watch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "lucide-react": "^0.462.0",
    "maplibre-gl": "^6.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
